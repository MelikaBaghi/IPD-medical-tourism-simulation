						</RecurrenceCode>
						<Condition><![CDATA[false]]></Condition>
					</Properties>
					<Action><![CDATA[//traceln(time());
EarlyOut = randomTrue(0.05);
if (randomTrue(0.05)){
	DrLink.disconnect();
	main.defineDoctor(this);
	DrLink.connectTo(main.doctors(WhichDr));
	//traceln("Haaaa");
	}
	
if (uniform_discr(0, 100)<1){
	if ((inState(WaitForVisit)) || (inState(WaitInHome))){
		emergent = true;
		//traceln("HOoooooo");
		//traceln(time());
		}}
else{
	emergent = false;
	//traceln("Haaaa");
	}]]></Action>
				</Event>
