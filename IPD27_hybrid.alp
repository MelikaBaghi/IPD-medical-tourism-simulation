			<CustomGeneratorCode>new Random()</CustomGeneratorCode>
			<AfterSimulationRunCode><![CDATA[// Auto-log results to CSV after each run.
// The file is written next to the model. To send it somewhere else, replace
// the relative name below with an absolute path on your own machine.
try {
    String path = "loaded_hybrid.csv";
    java.io.File f = new java.io.File(path);
    boolean newFile = !f.exists();
    java.io.FileWriter w = new java.io.FileWriter(f, true);
    if (newFile) {
        w.write("run_finished,EarlyLeave,WaitSystem,WaitHospQueue,TouristWaitHospQueue,EmergencyBeforeTurn,Recovered,Util_Spec1,Util_Spec2,Util_Spec3,Util_Spec4,Util_Spec5,Util_Practitioner\n");
    }
    w.write(getEngine().time() + "," + root.LeaveBefore + "," + root.TotalWT.mean() + "," + root.HospitalWT.mean() + "," + root.HospitalTouristWT.mean() + "," + root.InQueueButEmergent + "," + root.Cured + "," + (100*root.Specialist1.utilization()) + "," + (100*root.Specialist2.utilization()) + "," + (100*root.Specialist3.utilization()) + "," + (100*root.Specialist4.utilization()) + "," + (100*root.Specialist5.utilization()) + "," + (100*root.Practitioner.utilization()) + "\n");
    w.close();
    traceln("ROW SAVED to loaded_hybrid.csv");
} catch (Exception e) { traceln("COULD NOT SAVE: " + e.getMessage()); }
]]></AfterSimulationRunCode>
