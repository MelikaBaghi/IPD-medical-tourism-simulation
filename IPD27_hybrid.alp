					<Action><![CDATA[Patient p;
int s;
for(s=0; s<5; s++){
	if (sections(s).Time.size()>0){
	if (sections(s).Time.get(0) <= time()){
		p = sections.get(s).PTime.get(0);
		if (sections.get(s).code.get(0))
			waitForTreatment2.free(p);
		else
			waitForTreatment1.free(p);
		sections.get(s).Time.remove(0);
		sections.get(s).PTime.remove(0);
		sections.get(s).code.remove(0);
	}}
}]]></Action>
