					</Parameter>
					<Body><![CDATA[if (doctor.patient.size() > 0) {
	//traceln("man oomadam tooooo");
	Patient p = doctor.patient.get(0);
	if (doctor.code.get(0) == true){
		if (p.FilledSlot == doctor.HospitalSlot){
			p.FilledSlot = 0;
				//wait.free(p);
				//traceln("Hospital az Dr" +i + "om daram hazf mikonam patient "+ p+ "om ro");
				//traceln("ine "+doctors.get(i).patient.get(0));
			doctor.patient.remove(0);
			doctor.code.remove(0);
			//doctor.Hospital_P --;
		}else{ 
			p.FilledSlot ++;}			
	}else{
		if (p.FilledSlot == doctor.VideoSlot){
			p.FilledSlot = 0;
				//Out1.stopDelay(p);
				//traceln("Videro az Dr" +i + "om daram hazf mikonam patient "+ p+ "om ro");
				//traceln("ine "+doctors.get(i).patient.get(0));				
			doctor.patient.remove(0);
			doctor.code.remove(0);
		}else{ 
			p.FilledSlot ++;}
		}
}
]]></Body>
