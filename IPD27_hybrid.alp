				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1678019873719</Id>
					<Name><![CDATA[defineDoctor]]></Name>
					<X>1690</X><Y>580</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[p]]></Name>
						<Type><![CDATA[Patient]]></Type>
					</Parameter>
					<Body><![CDATA[int i, j, k;
k = 0;
switch (p.Disease) {
	case BreastCancer:
		p.WhichDr = selectDoctor(0, sections(0).Spec - 1);
		break;
	case LungCancer:
		k = sections(0).Spec;
		p.WhichDr = selectDoctor(k , k + sections(1).Spec - 1);
		break;
	case HeartDisease:
		for (j = 0 ; j<2 ; j++)
	 		k += sections(j).Spec;
		p.WhichDr = selectDoctor(k, k + sections(2).Spec - 1);
		break;
	case CosmeticSurgery:
		for (j = 0 ; j<3 ; j++)
	 		k += sections(j).Spec;
		p.WhichDr = selectDoctor(k, k + sections(3).Spec - 1);
		break;
	case ColonCancer:
		for (j = 0 ; j<4 ; j++)
	 		k += sections(j).Spec;
		p.WhichDr = selectDoctor(k, k + sections(4).Spec - 1);
		break;
}]]></Body>
				</Function>
