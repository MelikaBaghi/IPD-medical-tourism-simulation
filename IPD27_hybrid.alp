					<Name><![CDATA[OnlineTreat]]></Name>
					<Description><![CDATA[
if ((lastIDV == agent.getId()) & (changeState(agent)))
	doctors(agent.WhichDr).GotoHospital = true;
else if ((lastIDV == agent.getId()) & (!changeState(agent)))
	doctors(agent.WhichDr).GotoHome = true;
	else
		doctors(agent.WhichDr).GotoHospital = false;



(appointment1.size()==0) && 

(changeState(agent)) && ]]></Description>
					<X>774</X><Y>1232</Y>
					<Label><X>-19</X><Y>53</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<ActiveObjectClass>
						<PackageName><![CDATA[com.anylogic.libraries.processmodeling]]></PackageName>
