				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1678119718863</Id>
					<Name><![CDATA[schedulingToHospitalizationOnline]]></Name>
					<X>1540</X><Y>670</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[p]]></Name>
						<Type><![CDATA[Patient]]></Type>
					</Parameter>
					<Body><![CDATA[int i, j;
i = 0;
j = 0;
switch (p.Disease) {
	case BreastCancer:
		i = 0;
		if (hospital1.WaitForEmptyBed.size()>noEmpty)
			j=1;
		break;
	case LungCancer:
		i = 1;
		if (hospital2.WaitForEmptyBed.size()>noEmpty)
			j=1;
		break;
	case HeartDisease:
		i = 2;
		if (hospital3.WaitForEmptyBed.size()>noEmpty)
			j=1;
		break;
	case CosmeticSurgery:
		i = 3;
		if (hospital4.WaitForEmptyBed.size()>noEmpty)
			j=1;
		break;
	case ColonCancer:
		i = 4;
		if (hospital5.WaitForEmptyBed.size()>noEmpty)
			j=1;
		break;
}

sections.get(i).BedSchedule.add(p);
if (j == 1)
	sections.get(i).Time.add(sections.get(i).Count + DaysAfter);
else
	sections.get(i).Time.add(sections.get(i).Count);
sections.get(i).PTime.add(p);
sections.get(i).code.add(false);]]></Body>
				</Function>
