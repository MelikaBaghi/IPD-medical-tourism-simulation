							<Value Class="CodeValue">
								<Code><![CDATA[doctors(agent.WhichDr).VisitTime = (time() - doctors(agent.WhichDr).start) + doctors(agent.WhichDr).VisitTime;
doctors(agent.WhichDr).receive( "Finish" );

if ( (hospital1.toVisit.size() == 0))
	doctors(agent.WhichDr).GotoHome = true;
else
	doctors(agent.WhichDr).GotoHome = false;
	
agent.patient.setVisible(false);
Experience(agent);]]></Code>
							</Value>
