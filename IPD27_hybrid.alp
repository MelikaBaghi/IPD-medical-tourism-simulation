					</Properties>
					<Action><![CDATA[if ((sections(0).HowMany > 0) && (sections(0).HowMany <= sections(0).Beds-hospital1.variable)){
	sections(0).receive("PutBack");
	sections(0).FromWhere.receive("TakeBack");
	sections(0).TotalBeds -=sections(0).HowMany;
	sections(0).HowMany = 0;}

if ((sections(1).HowMany > 0) && (sections(1).HowMany <= sections(1).Beds-hospital2.variable)){
	sections(1).receive("PutBack");
	sections(1).FromWhere.receive("TakeBack");
	sections(1).TotalBeds -=sections(0).HowMany;
	sections(1).HowMany = 0;}
	
if ((sections(4).HowMany > 0) && (sections(4).HowMany <= sections(4).Beds-hospital5.variable)){
	sections(4).receive("PutBack");
	sections(4).FromWhere.receive("TakeBack");
	sections(4).TotalBeds -=sections(0).HowMany;
	sections(4).HowMany = 0;}]]></Action>
				</Event>
