					</Parameter>
					<Body><![CDATA[p.previousExperience = p.previousExperience + p.healthStatus - p.previousHealthStatus;
doctors(p.WhichDr).Popularity = doctors(p.WhichDr).Popularity + p.healthStatus - p.previousHealthStatus;]]></Body>
