			<Functions>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1678887392737</Id>
					<Name><![CDATA[showAnimation]]></Name>
					<X>40</X><Y>210</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[document.setVisible(false);
man.setVisible(false);
//money.setVisible(false);
//checkMark.setVisible(false);
//cross.setVisible(false);
message.setVisible(false);
//rectangle.setVisible(false);
patient.setVisible(false);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[int]]></ReturnType>
					<Id>1679842418524</Id>
					<Name><![CDATA[behavior]]></Name>
					<X>1110</X><Y>180</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[p]]></Name>
						<Type><![CDATA[Patient]]></Type>
					</Parameter>
					<Body><![CDATA[int a, v;
if (p.age > 50)
	a = 2;
else if (p.age < 10)
		a = 0;
	else
		a = 1;

v = 5 * a + 7 * p.healthStatus + 2 * p.availability;
if (p.gender == Female)
	v --;
if (p.personalityTrait == Anxious)
	v = v - 10;
else if (p.personalityTrait == Relax)
	v = v + 5;
if (v < 25)
	return 1;
else if (v < 40)
		return 2;
	else
		return 3;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1681048969799</Id>
					<Name><![CDATA[AnswerQuestionDuration]]></Name>
					<X>1110</X><Y>60</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[p]]></Name>
						<Type><![CDATA[Patient]]></Type>
					</Parameter>
					<Body><![CDATA[Doctor d;
d = main.doctors.get(p.WhichDr);
switch (d.Specilization) {
	case BreastCancer:
		if (p.personalityTrait == Relax)
			return triangular(10, 15);
		if (p.personalityTrait == Normal)
			return triangular(2, 5) + triangular(10, 15);
		if (p.personalityTrait == Anxious)
			return triangular(10, 15) + triangular(10, 15);
		//break;
	case LungCancer:
		if (p.personalityTrait == Relax)
			return triangular(10, 15);
		if (p.personalityTrait == Normal)
			return triangular(2, 5) + triangular(10, 15);
		if (p.personalityTrait == Anxious)
			return triangular(10, 15) + triangular(10, 15);
		//break;
	case HeartDisease:
		if (p.personalityTrait == Relax)
			return triangular(5, 10);
		if (p.personalityTrait == Normal)
			return triangular(2, 5) + triangular(5, 10);
		if (p.personalityTrait == Anxious)
			return triangular(10, 15) + triangular(5, 10);
		//break;
	case CosmeticSurgery:
		if (p.personalityTrait == Relax)
			return triangular(5, 7);
		if (p.personalityTrait == Normal)
			return triangular(2, 5) + triangular(5, 7);
		if (p.personalityTrait == Anxious)
			return triangular(10, 15) + triangular(5, 7);
		//break;
	case ColonCancer:
		if (p.personalityTrait == Relax)
			return triangular(5, 10);
		if (p.personalityTrait == Normal)
			return triangular(2, 5) + triangular(5, 10);
		if (p.personalityTrait == Anxious)
			return triangular(10, 15) + triangular(5, 10);
		//break;
}
return triangular(2, 5);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1681738709055</Id>
					<Name><![CDATA[BeingCheckupDuration]]></Name>
					<X>1110</X><Y>30</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[p]]></Name>
						<Type><![CDATA[Patient]]></Type>
					</Parameter>
					<Body><![CDATA[Doctor d;
d = main.doctors.get(p.WhichDr);
switch (d.Specilization) {
	case BreastCancer:
		if (p.personalityTrait == Relax)
			return triangular(10, 15);
		if (p.personalityTrait == Normal)
			return triangular(2, 5) + triangular(10, 15);
		if (p.personalityTrait == Anxious)
			return triangular(10, 15) + triangular(10, 15);
		//break;
	case LungCancer:
		if (p.personalityTrait == Relax)
			return triangular(10, 15);
		if (p.personalityTrait == Normal)
			return triangular(2, 5) + triangular(10, 15);
		if (p.personalityTrait == Anxious)
			return triangular(10, 15) + triangular(10, 15);
		//break;
	case HeartDisease:
		if (p.personalityTrait == Relax)
			return triangular(2, 5);
		if (p.personalityTrait == Normal)
			return triangular(2, 5) + triangular(2, 5);
		if (p.personalityTrait == Anxious)
			return triangular(10, 15) + triangular(2, 5);
		//break;
	case CosmeticSurgery:
		if (p.personalityTrait == Relax)
			return triangular(2, 3);
		if (p.personalityTrait == Normal)
			return triangular(2, 5) + triangular(2, 3);
		if (p.personalityTrait == Anxious)
			return triangular(10, 15) + triangular(2, 3);
		//break;
	case ColonCancer:
		if (p.personalityTrait == Relax)
			return triangular(2, 5);
		if (p.personalityTrait == Normal)
			return triangular(2, 5) + triangular(2, 5);
		if (p.personalityTrait == Anxious)
			return triangular(10, 15) + triangular(2, 5);
		//break;
}
return triangular(2, 5);]]></Body>
				</Function>
