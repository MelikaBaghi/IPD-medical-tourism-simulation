						<Parameter>
							<Name><![CDATA[forceStatisticsCollection]]></Name>
						</Parameter>
						<Parameter>
							<Name><![CDATA[onEnter]]></Name>
							<Value Class="CodeValue">
								<Code><![CDATA[doctors(agent.WhichDr).receive( "Clinic" );
doctors(agent.WhichDr).start = time();
agent.patient.setVisible(true);
agent.previousHealthStatus = agent.healthStatus;
defineRisk(agent);

agent.receive( "Come" );
doctors(agent.WhichDr).PatientID = agent;
doctors(agent.WhichDr).PatientLink.connectTo(agent);

doctors(agent.WhichDr).IsBusy = true;]]></Code>
							</Value>
						</Parameter>
						<Parameter>
							<Name><![CDATA[onAtExit]]></Name>
						</Parameter>
						<Parameter>
							<Name><![CDATA[onExit]]></Name>
							<Value Class="CodeValue">
								<Code><![CDATA[agent.visit ++;
if ((appointment.size()==0)  ){
	doctors(agent.WhichDr).GotoHospital = true;
	doctors(agent.WhichDr).receive("Boro");
	//traceln(doctors(agent.WhichDr).InClinic);
	}
else if ((appointment.size()==0) && (!changeState(agent)) && (appointment1.size()==0))
	doctors(agent.WhichDr).GotoHome = true;
	//else
		//doctors(agent.WhichDr).GotoHospital = false;
	
agent.patient.setVisible(false);

defineAvailability(agent);
agent.endVisit = true;
agent.emergent = false;

doctors(agent.WhichDr).receive( "FinishC" );
doctors(agent.WhichDr).finish = time();
doctors(agent.WhichDr).VisitTime = (doctors(agent.WhichDr).finish - doctors(agent.WhichDr).start) + doctors(agent.WhichDr).VisitTime;

Experience(agent);

doctors(agent.WhichDr).IsBusy = false;

doctors(agent.WhichDr).NofPatients --;

if ((doctors(agent.WhichDr).NofPatients==0) & (changeState(agent)))
	doctors(agent.WhichDr).GotoHospital = true;
else if ((doctors(agent.WhichDr).NofPatients==0) & (!changeState(agent)))
	doctors(agent.WhichDr).GotoHome = true;
	else
		doctors(agent.WhichDr).GotoHospital = false;
		
doctors(agent.WhichDr).PatientLink.disconnect();]]></Code>
							</Value>
						</Parameter>
