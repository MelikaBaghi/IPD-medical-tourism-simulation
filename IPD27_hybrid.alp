					<Body><![CDATA[if (p.Type == Tourist){
	if (p.visit == 0)
		p.OnlineOrNot = true;
	else 
		p.OnlineOrNot = randomTrue(0.2);}
if (p.Type == Local)
	p.OnlineOrNot = randomTrue(0.3);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
