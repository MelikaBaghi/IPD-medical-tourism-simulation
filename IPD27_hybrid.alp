				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[boolean]]></ReturnType>
					<Id>1679032788313</Id>
					<Name><![CDATA[stayOrNot]]></Name>
					<X>1690</X><Y>610</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[p]]></Name>
						<Type><![CDATA[Patient]]></Type>
					</Parameter>
					<Body><![CDATA[switch (p.Disease) {
	case BreastCancer:
		if (hospital1.WaitForEmptyBed.size()<noEmpty)
			return true;
		break;
	case LungCancer:
		if (hospital2.WaitForEmptyBed.size()<noEmpty)
			return true;		
		break;
	case HeartDisease:
		if (hospital3.WaitForEmptyBed.size()<noEmpty)
			return true;
		break;
	case CosmeticSurgery:
		if (hospital4.WaitForEmptyBed.size()<noEmpty)
			return true;	
		break;
	case ColonCancer:
		if (hospital5.WaitForEmptyBed.size()<noEmpty)
			return true;
		break;
}
return false;
]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1679036604645</Id>
					<Name><![CDATA[schedulingToHospitalizationInPerson]]></Name>
					<X>1540</X><Y>700</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[p]]></Name>
						<Type><![CDATA[Patient]]></Type>
					</Parameter>
					<Body><![CDATA[int i;
i = 0;
switch (p.Disease) {
	case BreastCancer:
		i = 0;
		break;
	case LungCancer:
		i = 1;
		break;
	case HeartDisease:
		i = 2;
		break;
	case CosmeticSurgery:
		i = 3;
		break;
	case ColonCancer:
		i = 4;
		break;
}

sections.get(i).BedSchedule.add(p);
sections.get(i).Time.add(sections.get(i).Count + DaysAfter);
sections.get(i).PTime.add(p);
sections.get(i).code.add(true);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1680158560864</Id>
					<Name><![CDATA[defineRisk]]></Name>
					<X>1690</X><Y>490</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[p]]></Name>
						<Type><![CDATA[Patient]]></Type>
					</Parameter>
					<Body><![CDATA[int i;
i = uniform_discr(0, 11);
switch (p.Disease) {
	case BreastCancer:
		if (i<3)
			p.healthStatus = 3;
		else if ((i<8) || (p.visit >= 3))
				p.healthStatus = 2;
			else
				p.healthStatus = 1;
	break;
	case LungCancer:
		if (i<4)
			p.healthStatus = 3;
		else if ((i<8) || (p.visit >= 2))
				p.healthStatus = 2;
			else
				p.healthStatus = 1;
	break;
	case HeartDisease:
		if (i<5)
			p.healthStatus = 3;
		else if ((i<9) || (p.visit >= 4))
				p.healthStatus = 2;
			else
				p.healthStatus = 1;
	break;
	case CosmeticSurgery:
		if ((i<2) || (p.visit == 0))
			p.healthStatus = 3;
		else if ((i<3) || (p.visit == 1))
				p.healthStatus = 2;
			else
				p.healthStatus = 1;
	break;
	case ColonCancer:
		if (i<4)
			p.healthStatus = 3;
		else if ((i<8) || (p.visit >= 2))
				p.healthStatus = 2;
			else
				p.healthStatus = 1;
	break;
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1680172245520</Id>
					<Name><![CDATA[defineAvailability]]></Name>
					<X>1690</X><Y>520</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[p]]></Name>
						<Type><![CDATA[Patient]]></Type>
					</Parameter>
					<Body><![CDATA[int i;
i = uniform_discr(0, 11);
switch (p.Disease) {
	case BreastCancer:
		if (i<2)
			p.availability = 3;
		else if (i < 6)
				p.availability = 2;
			else
				p.availability = 1;
	break;
	case LungCancer:
		if (i<2)
			p.availability = 3;
		else if (i < 5)
				p.availability = 2;
			else
				p.availability = 1;
	break;
	case HeartDisease:
		if (i<5)
			p.availability = 3;
		else if (i < 7)
				p.availability = 2;
			else
				p.availability = 1;
	break;
	case CosmeticSurgery:
		if (i<1)
			p.availability = 3;
		else if (i < 3)
				p.availability = 2;
			else
				p.availability = 1;
	break;
	case ColonCancer:
		if (i<2)
			p.availability = 3;
		else if (i < 8)
				p.availability = 2;
			else
				p.availability = 1;
	break;
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1680629176017</Id>
					<Name><![CDATA[periodOfTakingPills]]></Name>
					<X>1820</X><Y>310</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[p]]></Name>
						<Type><![CDATA[Patient]]></Type>
					</Parameter>
					<Body><![CDATA[switch (p.Disease) {
	case BreastCancer:
		if (p.visit<2)
			return 2;
		else if (p.visit < 8)
				return 5;
			else
				return triangular( 5, 10, 15 );
	//break;
	case LungCancer:
		if (p.visit<3)
			return 3;
		else if (p.visit < 9)
				return 7;
			else
				return 10;
	//break;
	case HeartDisease:
		if (p.visit<3)
			return 1;
		else if (p.visit < 10)
				return 5;
			else
				return 15;
	//break;
	case CosmeticSurgery:
		if (p.visit<2)
			return 7;
		else if (p.visit < 4)
				return 10;
			else
				return 20;
	//break;
	case ColonCancer:
		if (p.visit<2)
			return 3;
		else if (p.visit < 7)
				return 2;
			else
				return 4;
	//break;
}
return triangular( 1, 3, 2 );]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[boolean]]></ReturnType>
					<Id>1682352850480</Id>
					<Name><![CDATA[decision]]></Name>
					<ExcludeFromBuild>true</ExcludeFromBuild>
					<X>1300</X><Y>1790</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[p]]></Name>
						<Type><![CDATA[Patient]]></Type>
					</Parameter>
					<Body><![CDATA[if (p.Type == Tourist)
	return randomTrue(0.8);
	else if (p.Type == Local)
		return randomTrue(0.3);
		else
			return false;
	]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[int]]></ReturnType>
					<Id>1683435992299</Id>
					<Name><![CDATA[selectDoctor]]></Name>
					<X>1540</X><Y>580</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[start]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[finish]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Body><![CDATA[int i, ans = start, totalS = 0, j=0;
//double p[]= 0.0 , score[]= 0.0;
//List<double> p = new ArrayList<>();
//List<double> score = new ArrayList<>();
double[] p = new double[finish- start+1];
double[] score = new double[finish- start+1];
for(i = start ; i <= finish; i++ ){
	int size = doctors(i).patient.size();
	int pop = doctors(i).Popularity;
	score[j] = pop + 1/(15*size + 1);
	totalS += score[j];
	j ++;
//	if (max < score){
//		max = score;
//		maxIdx = i;
//	}
}
for(i = 0 ; i <= finish-start; i++ ){
	p[i] = score[i]/totalS;}
for(i = 1 ; i <= finish-start; i++ ){
	p[i]+= p[i-1];}
	
double r = random();
	for(i = 0 ; i <= finish-start; i++ ){
		if (r <= p[i]){
			ans = start + i;
			//traceln("shod!" + "r = " + r + " P = " + p[i], " i = " + i);
			break;}
		else{
			ans = uniform_discr(start, finish);
			//traceln("nashod");
			}}

return ans;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
