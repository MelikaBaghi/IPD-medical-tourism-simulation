						<Parameter>
							<Name><![CDATA[onEnter]]></Name>
							<Value Class="CodeValue">
								<Code><![CDATA[if (agent.FileNo == 0){
	Number = Number + 1;
	//traceln("New patient "+Number);
	agent.FileNo = Number;
	defineDoctor(agent);
	agent.DrLink.connectTo(doctors(agent.WhichDr));
	switch (agent.Disease) {
	case BreastCancer:
		agent.SumVisit = (int)triangular(2, 7);
		break;
	case LungCancer:
		agent.SumVisit = (int)triangular(2, 6);
		break;
	case HeartDisease:
		agent.SumVisit = (int)triangular(5, 10);
		break;
	case CosmeticSurgery:
		agent.SumVisit = (int)triangular(1, 3);
		break;
	case ColonCancer:
		agent.SumVisit = (int)triangular(2, 5);
		break;
}
}

Total_in = RequestTreatment.count();

agent.healthStatus = 0;
agent.receive("Again");
agent.endVisit = false;]]></Code>
							</Value>
						</Parameter>
