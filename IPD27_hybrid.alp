					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Properties TriggerType="timeout" Mode="cyclic">
						<Timeout Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="TimeUnits"><![CDATA[DAY]]></Unit>
						</Timeout>
						<Rate Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="RateUnits"><![CDATA[PER_DAY]]></Unit>
						</Rate>
						<Id>1656468989963</Id>
						<OccurrenceAtTime>true</OccurrenceAtTime>
						<OccurrenceDate>1676188800000</OccurrenceDate>
						<OccurrenceTime Class="CodeUnitValue">
							<Code><![CDATA[0]]></Code>
							<Unit Class="TimeUnits"><![CDATA[DAY]]></Unit>
						</OccurrenceTime>
						<RecurrenceCode Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="TimeUnits"><![CDATA[DAY]]></Unit>
						</RecurrenceCode>
						<Condition><![CDATA[false]]></Condition>
					</Properties>
					<Action><![CDATA[if (hospital1.variable/sections(0).Beds >=0.5)
	sections(0).HaveCapacity = true;
if (hospital2.variable/sections(1).Beds >=0.5)
	sections(1).HaveCapacity = true;
if (hospital5.variable/sections(4).Beds >=0.5)
	sections(4).HaveCapacity = true;

if (hospital1.WaitForEmptyBed.size() > 3)
	sections(0).NeedCapacity = true;
if (hospital2.WaitForEmptyBed.size() > 3)
	sections(1).NeedCapacity = true;
if (hospital5.WaitForEmptyBed.size() > 3)
	sections(4).NeedCapacity = true;

if (sections(0).NeedCapacity){
	if (sections(1).HaveCapacity || sections(4).HaveCapacity){
		sections(0).CanBorrow = true;
		if ((sections(1).HaveCapacity) && (sections(4).HaveCapacity == false)){
			sections(0).FromWhere = sections(1);
			sections(0).HowMany = (int)floor((hospital2.variable-sections(1).Beds)*0.5);
			sections(0).TotalBeds += sections(0).HowMany;
			sections(1).HaveCapacity = false;
			sections(1).BorrowTo = true;}
		else if ((sections(1).HaveCapacity == false) && (sections(4).HaveCapacity)){
				sections(0).FromWhere = sections(4);
				sections(0).HowMany = (int)floor((hospital5.variable-sections(4).Beds)*0.5);
				sections(0).TotalBeds += sections(0).HowMany;
				sections(4).HaveCapacity = false;
				sections(4).BorrowTo = true;}
			else if (hospital5.variable-sections(4).Beds>hospital2.variable-sections(1).Beds){
					sections(0).FromWhere = sections(4);
					sections(0).HowMany = (int)floor((hospital5.variable-sections(4).Beds)*0.5);
					sections(0).TotalBeds += sections(0).HowMany;
					sections(4).HaveCapacity = false;
					sections(4).BorrowTo = true;}
				else{
					sections(0).FromWhere = sections(1);
					sections(0).HowMany = (int)floor((hospital2.variable-sections(1).Beds)*0.5);
					sections(0).TotalBeds += sections(0).HowMany;
					sections(1).HaveCapacity = false;
					sections(1).BorrowTo = true;}
	sections(0).NeedCapacity = false;}}
if (sections(1).NeedCapacity){
	if (sections(0).HaveCapacity || sections(4).HaveCapacity){
		sections(1).CanBorrow = true;
		if ((sections(0).HaveCapacity) && (sections(4).HaveCapacity == false)){
			sections(1).FromWhere = sections(0);
			sections(1).HowMany = (int)floor((hospital1.variable-sections(0).Beds)*0.5);
			sections(1).TotalBeds += sections(1).HowMany;
			sections(0).HaveCapacity = false;
			sections(0).BorrowTo = true;}
		else if ((sections(0).HaveCapacity == false) && (sections(4).HaveCapacity)){
				sections(1).FromWhere = sections(4);
				sections(1).HowMany = (int)floor((hospital5.variable-sections(4).Beds)*0.5);
				sections(1).TotalBeds += sections(1).HowMany;
				sections(4).HaveCapacity = false;
				sections(4).BorrowTo = true;}
			else if (hospital5.variable-sections(4).Beds>hospital1.variable-sections(0).Beds){
					sections(1).FromWhere = sections(4);
					sections(1).HowMany = (int)floor((hospital5.variable-sections(4).Beds)*0.5);
					sections(1).TotalBeds += sections(1).HowMany;
					sections(4).HaveCapacity = false;
					sections(4).BorrowTo = true;}
				else{
					sections(1).FromWhere = sections(0);
					sections(1).HowMany = (int)floor((hospital1.variable-sections(0).Beds)*0.5);
					sections(1).TotalBeds += sections(1).HowMany;
					sections(0).HaveCapacity = false;
					sections(0).BorrowTo = true;}
	sections(1).NeedCapacity = false;}}
if (sections(4).NeedCapacity){
	if (sections(1).HaveCapacity || sections(0).HaveCapacity){
		sections(4).CanBorrow = true;
			if ((sections(0).HaveCapacity) && (sections(1).HaveCapacity == false)){
			sections(4).FromWhere = sections(0);
			sections(4).HowMany = (int)floor((hospital1.variable-sections(0).Beds)*0.5);
			sections(4).TotalBeds += sections(4).HowMany;
			sections(0).HaveCapacity = false;
			sections(0).BorrowTo = true;}
		else if ((sections(0).HaveCapacity == false) && (sections(1).HaveCapacity)){
				sections(4).FromWhere = sections(1);
				sections(4).HowMany = (int)floor((hospital2.variable-sections(1).Beds)*0.5);
				sections(4).TotalBeds += sections(4).HowMany;
				sections(1).HaveCapacity = false;
				sections(1).BorrowTo = true;}
			else if (hospital2.variable-sections(1).Beds>hospital1.variable-sections(0).Beds){
					sections(4).FromWhere = sections(1);
					sections(4).HowMany = (int)floor((hospital2.variable-sections(1).Beds)*0.5);
					sections(4).TotalBeds += sections(4).HowMany;
					sections(1).HaveCapacity = false;
					sections(1).BorrowTo = true;}
				else{
					sections(4).FromWhere = sections(0);
					sections(4).HowMany = (int)floor((hospital1.variable-sections(0).Beds)*0.5);
					sections(4).TotalBeds += sections(4).HowMany;
					sections(0).HaveCapacity = false;
					sections(0).BorrowTo = true;}
	sections(4).NeedCapacity = false;}}]]></Action>
				</Event>
				<Event>
					<Id>1683564779971</Id>
					<Name><![CDATA[TakeBackeFromSections]]></Name>
