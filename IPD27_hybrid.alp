							<Name><![CDATA[waitForEmptyBed_onEnter]]></Name>
							<Value Class="CodeValue">
								<Code><![CDATA[if(hospital1.variable < sections(0).TotalBeds){
	hospital1.hold1.nEntitiesForSelfBlock = sections(0).TotalBeds - hospital1.variable;
	//hospital1.variable = sections(0).Beds;
	hospital1.hold1.unblock();}

agent.entryTime = time();

agent.man.setVisible(true);

if (agent.Type == Tourist)
	TouristNo ++;
else
	LocalNo++;

agent.HospitalTrue = true;
agent.WaitingInHospital = time();]]></Code>
							</Value>
