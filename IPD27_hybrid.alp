							</Value>
						</Parameter>
						<Parameter>
							<Name><![CDATA[waitForEmptyBed_onEnter]]></Name>
							<Value Class="CodeValue">
								<Code><![CDATA[if(hospital4.variable < sections(3).TotalBeds){
	hospital4.hold1.nEntitiesForSelfBlock = sections(3).TotalBeds - hospital4.variable;
	//hospital4.variable = sections(3).Beds;
	hospital4.hold1.unblock();}

agent.entryTime = time();
agent.man.setVisible(true);

if (agent.Type == Tourist)
	TouristNo ++;
else
	LocalNo++;
	
agent.HospitalTrue = true;
agent.WaitingInHospital = time();]]></Code>
							</Value>
