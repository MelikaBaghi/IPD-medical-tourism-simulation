							<Value Class="CodeValue">
								<Code><![CDATA[HospitalWT.add(time()-agent.entryTime);
TotalWT.add(time()-agent.entryTime);
if (agent.Type == Tourist)
	HospitalTouristWT.add(time()-agent.entryTime);

agent.man.setVisible(false);

if ((time()-agent.entryTime)>2)
	agent.previousExperience--;]]></Code>
