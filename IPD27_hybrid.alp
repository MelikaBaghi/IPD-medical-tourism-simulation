							<Value Class="CodeValue">
								<Code><![CDATA[//variable ++;
doctors(agent.WhichDr).start = time();
doctors(agent.WhichDr).receive( "Hospital" );

agent.patient.setVisible(true);

agent.previousHealthStatus = agent.healthStatus;

if (randomTrue(0.3)){
	agent.healthStatus --;
	agent.Days ++;}
	else{ if (randomTrue(0.5))
			agent.healthStatus ++;}]]></Code>
