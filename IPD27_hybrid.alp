					<Action><![CDATA[if (HomeTrue == true){
if (time() - WaitingInHome >=20){
	if(uniform_discr(0, 100)<5){
		Leave = true;}
	else
		Leave = false;
}
}
if (HospitalTrue){
if (time() - WaitingInHospital >=15){
	if(uniform_discr(0, 100)<=50){
		Leave = true;}
	else
		Leave = false;
}
}]]></Action>
				</Event>
