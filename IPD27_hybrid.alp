						<Parameter>
							<Name><![CDATA[visitInHospital_onExit]]></Name>
							<Value Class="CodeValue">
								<Code><![CDATA[doctors(agent.WhichDr).VisitTime = (time() - doctors(agent.WhichDr).start) + doctors(agent.WhichDr).VisitTime;
doctors(agent.WhichDr).receive( "Finish" );

if ( hospital4.toVisit.size() == 0)
	doctors(agent.WhichDr).GotoHome = true;
else
	doctors(agent.WhichDr).GotoHome = false;
		
agent.patient.setVisible(false);
Experience(agent);]]></Code>
							</Value>
						</Parameter>
						<Parameter>
							<Name><![CDATA[waitForEmptyBed_onExit]]></Name>
							<Value Class="CodeValue">
								<Code><![CDATA[HospitalWT.add(time()-agent.entryTime);
TotalWT.add(time()-agent.entryTime);
if (agent.Type == Tourist)
	HospitalTouristWT.add(time()-agent.entryTime);
agent.man.setVisible(false);
if ((time()-agent.entryTime)>2)
	agent.previousExperience--;]]></Code>
